# Copy this file to `.env` and fill in real values. `.env` itself is
# gitignored — never commit real secrets.

# Prisma / Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/training_platform?schema=public"

# Required — signs/verifies access tokens (JwtStrategy, TokenService). The app
# throws on boot if this is unset instead of running on a hardcoded default;
# generate one with `openssl rand -hex 32` and never reuse the same value
# across environments.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"

# Optional — Node environment; controls the `secure` flag on auth cookies
# (see shared/cookies/auth-cookies.util.ts). Cookies are only marked `secure`
# when this is exactly "production".
NODE_ENV="development"

# Optional — port the Nest HTTP server listens on. Defaults to 3000.
PORT=3000
